# Entorno y secretos: el .env lleva la SECRET_KEY, nunca se versiona
backend/.env
!.env.example

# Base de datos local (se recrea con `alembic upgrade head`)
backend/*.db

# Documentos subidos en desarrollo (backend/data es la ubicación actual;
# backend/documentos guarda los subidos antes de la historia #14)
backend/data/
backend/documentos/

# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node
frontend/node_modules/
frontend/dist/

# Editores y sistema operativo
.vscode/
.idea/
Thumbs.db
.DS_Store

# Varios
*.log
